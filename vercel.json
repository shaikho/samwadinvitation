{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": "public",
  "rewrites": [
    { "source": "/attendees", "destination": "/attendees.html" },
    { "source": "/addendies", "destination": "/attendees.html" }
  ],
  "headers": [
    {
      "source": "/wedding.ics",
      "headers": [
        { "key": "Content-Type", "value": "text/calendar; charset=utf-8" },
        { "key": "Content-Disposition", "value": "attachment; filename=\"sameer-waad-wedding.ics\"" }
      ]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
